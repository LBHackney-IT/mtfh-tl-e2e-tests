# Optional local overrides
# Cognito credentials and API endpoints are loaded from SSM by setEnv.sh.
#
#   source setEnv.sh <aws-sso-profile> development
#
# Uncomment only if you need to override defaults:

# Cognito flow is enabled by default (true). Set false to use legacy JWT auth.
# export CYPRESS_COGNITO_FLOW_ENABLED=false

# Legacy JWT auth — only when CYPRESS_COGNITO_FLOW_ENABLED=false
# export CYPRESS_E2E_ACCESS_TOKEN_DEVELOPMENT='<<your hackney JWT>>'
# export CYPRESS_E2E_ACCESS_TOKEN_STAGING='<<your hackney JWT>>'
# export CYPRESS_E2E_ACCESS_TOKEN_PRODUCTION='<<your hackney JWT>>'
